# discord.eo — مكتبة بوتات ديسكورد للغة eo
#
#   import discord
#   load_env()
#   var bot = discord.Bot(env("DISCORD_TOKEN"))
#   bot.command "ping", lambda msg, args {
#       msg.reply "pong"
#   }
#   bot.run
#
# كل حدث يشتغل داخل prc: لو كودك طلع فيه خطأ أو علّق، يطبع الخطأ والبوت يكمل.

const VERSION = "1.6.0"
const API = "https://discord.com/api/v10"
const GATEWAY = "wss://gateway.discord.gg/?v=10&encoding=json"

# Intents: وش الأحداث اللي يبيها البوت (اجمعها: discord.GUILDS + discord.GUILD_MESSAGES)
const GUILDS = 1
const GUILD_MEMBERS = 2
const GUILD_MODERATION = 4
const GUILD_EMOJIS = 8
const GUILD_INVITES = 64
const GUILD_VOICE_STATES = 128
const GUILD_PRESENCES = 256
const GUILD_MESSAGES = 512
const GUILD_MESSAGE_REACTIONS = 1024
const DIRECT_MESSAGES = 4096
const DIRECT_MESSAGE_REACTIONS = 8192
const MESSAGE_CONTENT = 32768
# ═════ الصلاحيات: msg.member.has_permission discord.BAN_MEMBERS ═════
const CREATE_INVITE = 1
const KICK_MEMBERS = 2
const BAN_MEMBERS = 4
const ADMINISTRATOR = 8
const MANAGE_CHANNELS = 16
const MANAGE_GUILD = 32
const ADD_REACTIONS = 64
const VIEW_AUDIT_LOG = 128
const SEND_MESSAGES = 2048
const MANAGE_MESSAGES = 8192
const ATTACH_FILES = 32768
const MENTION_EVERYONE = 131072
const MUTE_MEMBERS = 4194304
const DEAFEN_MEMBERS = 8388608
const MOVE_MEMBERS = 16777216
const MANAGE_NICKNAMES = 134217728
const MANAGE_ROLES = 268435456
const MODERATE_MEMBERS = 1099511627776
# نفسها بالاسم: msg.member.has_permission "ban_members"
const PERMISSIONS = {"create_invite": 1, "kick_members": 2, "ban_members": 4, "administrator": 8, "admin": 8, "manage_channels": 16, "manage_guild": 32, "manage_server": 32, "add_reactions": 64, "view_audit_log": 128, "send_messages": 2048, "manage_messages": 8192, "attach_files": 32768, "mention_everyone": 131072, "mute_members": 4194304, "deafen_members": 8388608, "move_members": 16777216, "manage_nicknames": 134217728, "manage_roles": 268435456, "moderate_members": 1099511627776, "timeout_members": 1099511627776}

# الافتراضي: السيرفرات، الرسائل، الخاص، الرياكشنات، ونص الرسائل
const DEFAULT_INTENTS = 46593
# كل شي (GUILD_MEMBERS و GUILD_PRESENCES و MESSAGE_CONTENT لازم تفعلها في Developer Portal)
const ALL_INTENTS = 47103

const COLOR = 16281969
const COMPONENTS_V2 = 32768

# ألوان جاهزة: discord.GREEN   (أو discord.color("#57F287"))
const RED = 15548997
const GREEN = 5763719
const BLUE = 5793266
const YELLOW = 16705372
const ORANGE = 15105570
const PURPLE = 10181046
const PINK = 15418782
const GOLD = 15844367
const WHITE = 16777215
const BLACK = 2303786
const GRAY = 9807270
const HIDDEN = 64

# الأحداث اللي تجيك بأسماء سهلة (والباقي بأسماء ديسكورد: "GUILD_BAN_ADD" ...)
const EVENTS = ["ready", "message", "message_edit", "message_delete", "member_join", "member_leave", "member_update", "reaction_add", "reaction_remove", "guild_join", "guild_leave", "channel_create", "channel_delete"]

# مستخدم ديسكورد
struct User {
    id @string
    name @string
    display_name @string
    bot @bool
    mention @string
    avatar_url @string
    raw @map
    client @(Bot, none)
}

# رسالة وصلت للبوت
struct Message {
    id @string
    content @string
    channel_id @string
    guild_id @string
    author @User
    bot @(Bot, none)
    raw @map
    member @(Member, none)
    mentions @list
    channel @(Channel, none)
    guild @(Guild, none)
    is_dm @bool = false
    jump_url @string
}

# البوت نفسه
struct Bot {
    token
    prefix @string = "!"
    intents @int = DEFAULT_INTENTS
    api @string = API
    gateway @string = GATEWAY
    log @bool = true
    user @(User, none)
    handlers @map
    commands @map
    session_id @string
    resume_url @string
    seq
    ws
    running @bool = false
    app_id @string
    guild_id @string
    ui @map
    components @map
    slash_commands @map
    next_id @int = 0
    id_prefix @string
    guilds @map
    dm_channels @map
    status @string = "online"
    activity @string
    activity_kind @int = 0
    startup_guilds @map
    # كم ثانية يقدر الأمر أو الحدث يشتغل قبل ما ينقطع (bot.timeout = 300 للأوامر الطويلة)
    timeout @int = 60
    command_perms @map
    # الرد لما أحد يستخدم أمر ما عنده صلاحيته
    no_permission @string = "❌ ما عندك صلاحية لهذا الأمر"
    beat @float = 41.25
    next_beat @float = 0.0
    acked @bool = true
}

# ═════ تسجيل الأحداث والأوامر ═════

# bot.on "ready", lambda { ... }     bot.on "message", lambda msg { ... }
# أو أي حدث من ديسكورد بالاسم: bot.on "GUILD_MEMBER_ADD", lambda data { ... }
# @hint Bot.on f(map)
# @hint Bot.on "ready" f()
# @hint Bot.on "message" f(Message)
# @hint Bot.on "message_edit" f(Message)
# @hint Bot.on "message_delete" f(Message)
# @hint Bot.on "member_join" f(Member)
# @hint Bot.on "member_leave" f(Member)
# @hint Bot.on "member_update" f(Member)
# @hint Bot.on "reaction_add" f(Reaction)
# @hint Bot.on "reaction_remove" f(Reaction)
# @hint Bot.on "guild_join" f(Guild)
# @hint Bot.on "guild_leave" f(Guild)
# @hint Bot.on "channel_create" f(Channel)
# @hint Bot.on "channel_delete" f(Channel)
func Bot.on event @string, f @lambda {
    var key = event
    if lower(event) in EVENTS {
        key = lower(event)
    }
    if not has(self.handlers, key) {
        self.handlers[key] = []
    }
    append self.handlers[key], f
}

# bot.command "ping", lambda msg, args { ... }   → يشتغل لما أحد يكتب !ping
# bot.command "ping", f   أو بأكثر من اسم:  bot.command ["ping", "p"], f
# @hint Bot.command f(Message, list)
#   وصلاحية اختيارية: bot.command "ban", f, "ban_members"   (بس اللي عنده الصلاحية يقدر يستخدمه)
func Bot.command name, f @lambda, permission = "" {
    var names = [name]
    if type(name) == "list" {
        names = name
    }
    for n in names {
        self.commands[lower(string(n))] = f
        if permission != "" and permission != 0 {
            self.command_perms[lower(string(n))] = permission
        } elif has(self.command_perms, lower(string(n))) {
            remove self.command_perms, lower(string(n))
        }
    }
}

# ═════ إرسال ═════

# bot.send channel_id, "نص"   أو   bot.send channel_id, {"content": "...", "embeds": [...]}
func Bot.send channel_id @string, content {
    return self.request("POST", "/channels/" + channel_id + "/messages", message_body(self, content))
}

# msg.reply "pong"   (رد على الرسالة نفسها)
func Message.reply content {
    var body = message_body(self.bot, content)
    body["message_reference"] = {"message_id": self.id}
    body["allowed_mentions"] = {"replied_user": false}
    return self.bot.request("POST", "/channels/" + self.channel_id + "/messages", body)
}

# msg.send "نص"   (رسالة عادية في نفس القناة)
func Message.send content {
    return self.bot.send(self.channel_id, content)
}

# msg.react "👍"   أو كذا وحدة:  msg.react ["1️⃣", "2️⃣", "3️⃣"]
func Message.react emoji {
    if type(emoji) == "list" {
        for e in emoji {
            self.react(e)
        }
        return none
    }
    return self.bot.request("PUT", "/channels/" + self.channel_id + "/messages/" + self.id + "/reactions/" + url_encode(string(emoji)) + "/@me", none)
}

# msg.edit "نص جديد"   (يعدل رسالة أرسلها البوت)
func Message.edit content {
    return self.bot.request("PATCH", "/channels/" + self.channel_id + "/messages/" + self.id, message_body(self.bot, content))
}

# msg.delete
func Message.delete {
    return self.bot.request("DELETE", "/channels/" + self.channel_id + "/messages/" + self.id, none)
}

# msg.reply_embed "العنوان", "النص"
func Message.reply_embed title @string, text @string = "", color @int = COLOR {
    return self.reply(make_embed(title, text, color))
}

# discord.embed("العنوان", "النص")  → صندوق مرتب تحطه في {"embeds": [...]}
func embed title @string, text @string {
    return {"title": title, "description": text, "color": COLOR}
}

# أي شي ترسله (نص، قاموس، Embed، View، LayoutView، Container) يتحول لجسم رسالة ديسكورد
func message_body b, content {
    var t = type(content)
    if t == "map" {
        return content
    }
    if t == "View" {
        var body = {}
        if content.content != "" {
            body["content"] = content.content
        }
        if len(content.embeds) > 0 {
            body["embeds"] = map(content.embeds, lambda e { embed_json(e) })
        }
        body["components"] = view_rows(b, content)
        return body
    }
    if t == "LayoutView" {
        return {"flags": COMPONENTS_V2, "components": build_items(b, content.items)}
    }
    if t == "Container" {
        return {"flags": COMPONENTS_V2, "components": build_items(b, [content])}
    }
    if t == "Embed" {
        return {"embeds": [embed_json(content)]}
    }
    return {"content": string(content)}
}

# أي طلب لـ Discord API:  bot.request("GET", "/users/@me", none)
func Bot.request method @string, path @string, body = none, reason @string = "", content_type @string = "" {
    var headers = {"Authorization": "Bot " + self.token, "User-Agent": "DiscordBot (https://eolang.netlify.app, " + VERSION + ")"}
    if reason != "" {
        headers["X-Audit-Log-Reason"] = url_encode(reason)
    }
    if content_type != "" {
        headers["Content-Type"] = content_type
    }
    var tries = 0
    while true {
        self._keepalive()
        var r = http(method, self.api + path, body, headers)
        if r["status"] == 429 and tries < 5 {
            var wait = 1
            if r["json"] != none {
                wait = get(r["json"], "retry_after", 1)
            }
            self._log "Rate limited, waiting " + string(wait) + "s"
            sleep wait
            tries += 1
            continue
        }
        if r["status"] == 0 {
            self._log "Could not reach Discord: " + r["error"]
        } elif r["status"] >= 400 {
            self._log "Discord said " + string(r["status"]) + " to " + method + " " + path + ": " + r["body"]
        }
        return r["json"]
    }
}

# ═════ التشغيل ═════

func Bot.run {
    if self.token == none or self.token == "" {
        print "[discord] No token. Put DISCORD_TOKEN=... in a .env file next to your bot, then: load_env()"
        exit 1
    }
    self.running = true
    var resume = false
    var fails = 0
    while self.running {
        var url = self.gateway
        if resume and self.resume_url != "" {
            url = self.resume_url
        }
        var code = self._connect(url, resume)
        if not self.running {
            break
        }
        if code == -1 {
            fails += 1
            var wait = fails * 5
            if wait > 60 {
                wait = 60
            }
            self._log "Can't connect (" + ws_error() + "), trying again in " + string(wait) + "s"
            sleep wait
            continue
        }
        fails = 0
        if code == 4004 {
            self._log "The token is wrong. Copy it again from the Developer Portal (Bot > Reset Token)."
            return
        }
        if code == 4013 or code == 4014 {
            self._log "Discord refused the intents. Turn on 'Message Content Intent' (and the others you use) in Developer Portal > Bot > Privileged Gateway Intents."
            return
        }
        if code == 4010 or code == 4011 or code == 4012 {
            self._log "Discord closed the connection for good (code " + string(code) + ")."
            return
        }
        resume = self.session_id != "" and code != 4007 and code != 4009
        if not resume {
            self.session_id = ""
            self.seq = none
        }
        self._log "Disconnected (code " + string(code) + "), reconnecting..."
        sleep 1
    }
}

# bot.stop   (يوقف البوت من داخل أي حدث)
func Bot.stop {
    self.running = false
    if self.ws != none {
        ws_close self.ws
        self.ws = none
    }
}

# اتصال واحد بالـ gateway، ويرجع كود الإغلاق (-1 = ما قدر يتصل)
func Bot._connect url @string, resume @bool {
    var ws = ws_connect(url)
    if ws == none {
        return -1
    }
    self.ws = ws
    self.beat = 41.25
    self.next_beat = now() + 3600
    self.acked = true
    while self.running {
        var wait = self.next_beat - now()
        if wait < 0 {
            wait = 0
        }
        var ev = ws_recv(ws, wait)
        if ev["type"] == "closed" {
            self.ws = none
            return ev["code"]
        }
        if ev["type"] == "timeout" {
            if not self.acked {
                ws_close ws, 4000
                self.ws = none
                return 4000
            }
            ws_send ws, {"op": 1, "d": self.seq}
            self.acked = false
            self.next_beat = now() + self.beat
            continue
        }
        var p = json_decode(ev["data"])
        if get(p, "s", none) != none {
            self.seq = p["s"]
        }
        var op = get(p, "op", -1)
        if op == 0 {
            self._dispatch(text_of(p, "t"), get(p, "d", none))
        } elif op == 10 {
            self.beat = p["d"]["heartbeat_interval"] / 1000.0
            self.next_beat = now() + self.beat * random()
            if resume {
                ws_send ws, {"op": 6, "d": {"token": self.token, "session_id": self.session_id, "seq": self.seq}}
            } else {
                ws_send ws, {"op": 2, "d": {"token": self.token, "intents": self.intents, "properties": {"os": "windows", "browser": "eo", "device": "eo"}, "presence": self._presence()}}
            }
        } elif op == 11 {
            self.acked = true
        } elif op == 1 {
            ws_send ws, {"op": 1, "d": self.seq}
        } elif op == 7 {
            ws_close ws, 4000
            self.ws = none
            return 4000
        } elif op == 9 {
            if get(p, "d", false) != true {
                self.session_id = ""
                self.seq = none
            }
            sleep 1 + random() * 4
            ws_close ws, 4000
            self.ws = none
            return 4000
        }
    }
    return 1000
}

func Bot._dispatch t @string, d {
    if t == "READY" {
        self.session_id = text_of(d, "session_id")
        self.resume_url = text_of(d, "resume_gateway_url") + "/?v=10&encoding=json"
        self.user = make_user(self, d["user"])
        self.app_id = self.user.id
        self.startup_guilds = {}
        for g in get(d, "guilds", []) {
            self.startup_guilds[text_of(g, "id")] = true
        }
        if has(d, "application") and d["application"] != none {
            self.app_id = text_of(d["application"], "id")
        }
        self._log "Online as " + self.user.name
        self._register_slash()
        self._emit("ready", [])
    } elif t == "INTERACTION_CREATE" {
        self._interaction(d)
    } elif t == "RESUMED" {
        self._log "Reconnected"
    } elif t == "MESSAGE_CREATE" {
        var msg = make_message(self, d)
        self._emit("message", [msg])
        if not msg.author.bot {
            self._command(msg)
        }
    } else {
        self._dispatch_more(t, d)
    }
    self._emit(t, [d])
}

# أمر طويل (يرسل لـ 100 عضو مثلًا): نبضة لديسكورد بين الطلبات عشان ما يقطع الاتصال
func Bot._keepalive {
    if self.ws != none and self.next_beat > 0 and now() >= self.next_beat {
        ws_send self.ws, {"op": 1, "d": self.seq}
        self.next_beat = now() + self.beat
    }
}

# ينادي كل اللي مسجلين على الحدث، كل واحد داخل prc (حد bot.timeout ثانية)
func Bot._emit key @string, args @list {
    if not has(self.handlers, key) {
        return
    }
    for f in self.handlers[key] {
        prc -s self.timeout {
            if len(args) == 0 {
                f()
            } else {
                f(args[0])
            }
        }
    }
}

func Bot._command msg @Message {
    if self.prefix == "" or not startswith(msg.content, self.prefix) {
        return
    }
    var words = filter(split(trim(msg.content), " "), lambda w { w != "" })
    if len(words) == 0 {
        return
    }
    var name = lower(slice(words[0], len(self.prefix)))
    if not has(self.commands, name) {
        return
    }
    var f = self.commands[name]
    var args = slice(words, 1)
    if has(self.command_perms, name) {
        if msg.member == none or not msg.member.has_permission(self.command_perms[name]) {
            if self.no_permission != "" {
                msg.reply self.no_permission
            }
            return
        }
    }
    prc -s self.timeout {
        f(msg, args)
    }
}

func Bot._log text @string {
    if self.log {
        print "[discord] " + text
    }
}

# ═════ تحويل بيانات ديسكورد ═════

func text_of m, key @string {
    if m == none or not has(m, key) {
        return ""
    }
    var v = m[key]
    if v == none {
        return ""
    }
    return string(v)
}

func make_user b, d {
    if d == none {
        d = {}
    }
    var id = text_of(d, "id")
    var name = text_of(d, "username")
    var shown = text_of(d, "global_name")
    if shown == "" {
        shown = name
    }
    var avatar = "https://cdn.discordapp.com/embed/avatars/0.png"
    if text_of(d, "avatar") != "" {
        avatar = "https://cdn.discordapp.com/avatars/" + id + "/" + text_of(d, "avatar") + ".png"
    } elif is_digits(id) {
        avatar = "https://cdn.discordapp.com/embed/avatars/" + string((int(id) / 4194304) % 6) + ".png"
    }
    return User{id: id, name: name, display_name: shown, bot: get(d, "bot", false) == true, mention: "<@" + id + ">", avatar_url: avatar, raw: d, client: b}
}

func make_message b @Bot, d {
    var m = Message{id: text_of(d, "id"), content: text_of(d, "content"), channel_id: text_of(d, "channel_id"), guild_id: text_of(d, "guild_id"), author: make_user(b, get(d, "author", {})), bot: b, raw: d}
    m.is_dm = m.guild_id == ""
    m.jump_url = jump_url(m.guild_id, m.channel_id, m.id)
    for u in get(d, "mentions", []) {
        append m.mentions, make_user(b, u)
    }
    if has(d, "member") and d["member"] != none {
        m.member = make_member(b, d["member"], m.guild_id, get(d, "author", {}))
    }
    m.guild = get(b.guilds, m.guild_id, none)
    m.channel = b.channel(m.channel_id)
    return m
}

# ═════════════════════════════════════════════
#  Embed
# ═════════════════════════════════════════════

# var e = discord.Embed("العنوان", "النص")
# e.field "الاسم", "القيمة"     e.image = "https://..."     msg.reply e
struct Embed {
    title @string
    description @string
    color @int = COLOR
    url @string
    image @string
    thumbnail @string
    footer @string
    author @string
    fields @list
}

func Embed.field name @string, value @string {
    append self.fields, {"name": name, "value": value, "inline": false}
    return self
}

# حقول جنب بعض
func Embed.inline name @string, value @string {
    append self.fields, {"name": name, "value": value, "inline": true}
    return self
}

func embed_json e {
    if type(e) == "map" {
        return e
    }
    var j = {"color": e.color}
    if e.title != "" {
        j["title"] = e.title
    }
    if e.description != "" {
        j["description"] = e.description
    }
    if e.url != "" {
        j["url"] = e.url
    }
    if e.image != "" {
        j["image"] = {"url": e.image}
    }
    if e.thumbnail != "" {
        j["thumbnail"] = {"url": e.thumbnail}
    }
    if e.footer != "" {
        j["footer"] = {"text": e.footer}
    }
    if e.author != "" {
        j["author"] = {"name": e.author}
    }
    if len(e.fields) > 0 {
        j["fields"] = e.fields
    }
    return j
}

# ═════════════════════════════════════════════
#  الأزرار والقوائم (View)
# ═════════════════════════════════════════════

# زر:  discord.Button("النص", lambda i { ... })
# style: "blue" "gray" "green" "red"  (أو primary secondary success danger)
# @hint Button callback(Interaction)
struct Button {
    label @string
    callback
    style @string = "blue"
    emoji @string
    url @string
    id @string
    disabled @bool = false
}

# قائمة اختيار. kind: "text" "user" "role" "channel" "mention"
# @hint Select callback(Interaction)
struct Select {
    placeholder @string
    options @list
    callback
    kind @string = "text"
    id @string
    min @int = 1
    max @int = 1
    disabled @bool = false
}

# رسالة فيها أزرار وقوائم:  var view = discord.View("النص فوق الأزرار")
struct View {
    content @string
    items @list
    embeds @list
}

# view.button "النص", lambda i { ... }   يرجع الزر عشان تعدله: b.style = "red"
# @hint View.button f(Interaction)
func View.button label @string, f {
    var b = Button(label, f)
    append self.items, b
    return b
}

# view.link "الموقع", "https://..."
func View.link label @string, url @string {
    var b = Button(label, none)
    b.url = url
    append self.items, b
    return b
}

# view.select "اختر", ["أ", "ب"], lambda i { i.values[0] }
# @hint View.select f(Interaction)
func View.select placeholder @string, options @list, f {
    var s = Select(placeholder, options, f)
    append self.items, s
    return s
}

# @hint View.user_select f(Interaction)
func View.user_select placeholder @string, f {
    var s = Select(placeholder, [], f)
    s.kind = "user"
    append self.items, s
    return s
}

# @hint View.role_select f(Interaction)
func View.role_select placeholder @string, f {
    var s = Select(placeholder, [], f)
    s.kind = "role"
    append self.items, s
    return s
}

# @hint View.channel_select f(Interaction)
func View.channel_select placeholder @string, f {
    var s = Select(placeholder, [], f)
    s.kind = "channel"
    append self.items, s
    return s
}

# أي زر أو قائمة سويتها بنفسك
func View.add item {
    append self.items, item
    return item
}

# اللي بعدها ينزل سطر جديد
func View.new_row {
    append self.items, "row"
}

func View.embed e {
    append self.embeds, e
}

# ═════════════════════════════════════════════
#  Components V2: LayoutView و Container
# ═════════════════════════════════════════════

# var layout = discord.LayoutView()
struct LayoutView {
    items @list
}

# صندوق بخط ملون على الجنب:  var box = layout.container()
struct Container {
    items @list
    color @int = COLOR
    spoiler @bool = false
}

# نص وجنبه صورة صغيرة أو زر
struct Section {
    text @string
    accessory
}

func LayoutView.container {
    var c = Container()
    append self.items, c
    return c
}
func LayoutView.text t @string {
    append self.items, text_display(t)
}
func LayoutView.separator {
    append self.items, {"type": 14, "divider": true, "spacing": 1}
}
func LayoutView.space {
    append self.items, {"type": 14, "divider": false, "spacing": 2}
}
func LayoutView.image url @string {
    append self.items, gallery_json([url])
}
func LayoutView.gallery urls @list {
    append self.items, gallery_json(urls)
}
func LayoutView.section t @string, accessory {
    var s = Section(t, accessory)
    append self.items, s
    return s
}
func LayoutView.row {
    var v = View()
    append self.items, v
    return v
}

func Container.text t @string {
    append self.items, text_display(t)
}
func Container.separator {
    append self.items, {"type": 14, "divider": true, "spacing": 1}
}
func Container.space {
    append self.items, {"type": 14, "divider": false, "spacing": 2}
}
func Container.image url @string {
    append self.items, gallery_json([url])
}
func Container.gallery urls @list {
    append self.items, gallery_json(urls)
}
func Container.section t @string, accessory {
    var s = Section(t, accessory)
    append self.items, s
    return s
}
func Container.row {
    var v = View()
    append self.items, v
    return v
}

func text_display t {
    return {"type": 10, "content": t}
}

func gallery_json urls @list {
    return {"type": 12, "items": map(urls, lambda u { gallery_item(u) })}
}

func gallery_item u {
    return {"media": {"url": string(u)}}
}

# ═════════════════════════════════════════════
#  Modal (نموذج يكتب فيه العضو)
# ═════════════════════════════════════════════

# var form = discord.Modal("العنوان", lambda i { i.fields["الاسم"] })
# @hint Modal callback(Interaction)
struct Modal {
    title @string
    callback
    inputs @list
    id @string
}

struct TextInput {
    label @string
    style @int = 1
    placeholder @string
    description @string
    value @string
    required @bool = true
    min @int = 0
    max @int = 4000
    id @string
}

# سطر واحد
func Modal.input label @string {
    var t = TextInput(label)
    append self.inputs, t
    return t
}

# نص طويل
func Modal.paragraph label @string {
    var t = TextInput(label)
    t.style = 2
    append self.inputs, t
    return t
}

# ═════════════════════════════════════════════
#  أوامر السلاش (/ping)
# ═════════════════════════════════════════════

struct Command {
    name @string
    description @string
    callback
    options @list
}

struct Option {
    name @string
    description @string
    kind @int = 3
    required @bool = true
    choices @list
}

# bot.slash "ping", "يرد pong", lambda i { i.reply "pong" }
# @hint Bot.slash f(Interaction)
func Bot.slash name @string, description @string, f {
    var c = Command(lower(name), description, f)
    self.slash_commands[lower(name)] = c
    return c
}

func Command._opt name @string, description @string, kind @int {
    var o = Option(lower(name), description, kind)
    append self.options, o
    return o
}
func Command.text name @string, description @string {
    return self._opt(name, description, 3)
}
func Command.number name @string, description @string {
    return self._opt(name, description, 4)
}
func Command.decimal name @string, description @string {
    return self._opt(name, description, 10)
}
func Command.boolean name @string, description @string {
    return self._opt(name, description, 5)
}
func Command.user name @string, description @string {
    return self._opt(name, description, 6)
}
func Command.channel name @string, description @string {
    return self._opt(name, description, 7)
}
func Command.role name @string, description @string {
    return self._opt(name, description, 8)
}

# زر يشتغل حتى بعد ما تعيد تشغيل البوت: b.id = "verify"  ثم  bot.component "verify", lambda i { }
# @hint Bot.component f(Interaction)
func Bot.component id @string, f {
    self.components[id] = f
}

func Bot._register_slash {
    var names = keys(self.slash_commands)
    if len(names) == 0 or self.app_id == "" {
        return
    }
    var list = []
    for n in names {
        var c = self.slash_commands[n]
        var opts = []
        for o in c.options {
            var j = {"type": o.kind, "name": o.name, "description": o.description, "required": o.required}
            if len(o.choices) > 0 {
                j["choices"] = map(o.choices, lambda ch { choice_json(ch) })
            }
            append opts, j
        }
        var desc = c.description
        if desc == "" {
            desc = c.name
        }
        append list, {"type": 1, "name": c.name, "description": desc, "options": opts}
    }
    var path = "/applications/" + self.app_id + "/commands"
    if self.guild_id != "" {
        path = "/applications/" + self.app_id + "/guilds/" + self.guild_id + "/commands"
    }
    var r = self.request("PUT", path, list)
    if type(r) == "list" {
        self._log "Slash commands ready: /" + join(names, " /")
    }
}

func choice_json ch {
    if type(ch) == "map" {
        return ch
    }
    return {"name": string(ch), "value": ch}
}

# ═════════════════════════════════════════════
#  Interaction (ضغطة زر، اختيار، نموذج، أمر سلاش)
# ═════════════════════════════════════════════

struct Interaction {
    id @string
    token @string
    kind @int
    name @string
    custom_id @string
    values @list
    options @map
    fields @map
    user @User
    member @(Member, none)
    guild @(Guild, none)
    channel_id @string
    guild_id @string
    message @(Message, none)
    bot @(Bot, none)
    raw @map
    responded @bool = false
}

func Interaction._callback kind @int, data {
    self.responded = true
    var body = {"type": kind}
    if data != none {
        body["data"] = data
    }
    return self.bot.request("POST", "/interactions/" + self.id + "/" + self.token + "/callback", body)
}

# i.reply "نص"   (أو View أو LayoutView أو Embed)
func Interaction.reply content {
    return self._callback(4, message_body(self.bot, content))
}

# رد يشوفه اللي ضغط بس
func Interaction.reply_hidden content {
    var body = message_body(self.bot, content)
    body["flags"] = get(body, "flags", 0) + HIDDEN
    return self._callback(4, body)
}

# i.reply_embed "عنوان", "نص"   ولو تبيه مخفي:  i.reply_embed "عنوان", "نص", discord.GREEN, true
func Interaction.reply_embed title @string, text @string = "", color @int = COLOR, hidden @bool = false {
    if hidden {
        return self.reply_hidden(make_embed(title, text, color))
    }
    return self.reply(make_embed(title, text, color))
}

# يعدل الرسالة اللي فيها الزر
func Interaction.update content {
    return self._callback(7, message_body(self.bot, content))
}

# "استنى شوي": لو بتاخذ أكثر من 3 ثواني، نادها أول شي وبعدين i.followup أو i.edit
func Interaction.defer {
    if self.kind == 3 {
        return self._callback(6, none)
    }
    return self._callback(5, none)
}

# يفتح نموذج
func Interaction.modal form @Modal {
    return self._callback(9, modal_json(self.bot, form))
}

# رسالة إضافية بعد الرد
func Interaction.followup content {
    if not self.responded {
        self.defer
    }
    return self.bot.request("POST", "/webhooks/" + self.bot.app_id + "/" + self.token, message_body(self.bot, content))
}

# يعدل ردك الأول
func Interaction.edit content {
    return self.bot.request("PATCH", "/webhooks/" + self.bot.app_id + "/" + self.token + "/messages/@original", message_body(self.bot, content))
}

func Bot._interaction d {
    var i = make_interaction(self, d)
    var f = none
    if i.kind == 2 {
        if has(self.slash_commands, i.name) {
            f = self.slash_commands[i.name].callback
        }
    } elif i.kind == 3 or i.kind == 5 {
        if has(self.ui, i.custom_id) {
            f = self.ui[i.custom_id].callback
        }
        if f == none and has(self.components, i.custom_id) {
            f = self.components[i.custom_id]
        }
    }
    if f != none {
        prc -s self.timeout {
            f(i)
        }
    }
    # زر ما رد: نقول لديسكورد وصلت عشان ما يطلع "This interaction failed"
    if i.kind == 3 and not i.responded {
        i.defer
    }
}

func make_interaction b @Bot, d {
    var data = get(d, "data", {})
    if data == none {
        data = {}
    }
    var u = none
    if has(d, "member") and d["member"] != none {
        u = d["member"]["user"]
    } else {
        u = get(d, "user", {})
    }
    var i = Interaction{id: text_of(d, "id"), token: text_of(d, "token"), kind: get(d, "type", 0), name: text_of(data, "name"), custom_id: text_of(data, "custom_id"), user: make_user(b, u), channel_id: text_of(d, "channel_id"), guild_id: text_of(d, "guild_id"), bot: b, raw: d}
    if has(d, "message") and d["message"] != none {
        i.message = make_message(b, d["message"])
    }
    if has(d, "member") and d["member"] != none {
        i.member = make_member(b, d["member"], i.guild_id, u)
    }
    i.guild = get(b.guilds, i.guild_id, none)
    i.values = get(data, "values", [])
    if i.values == none {
        i.values = []
    }
    var resolved = get(data, "resolved", {})
    for o in get(data, "options", []) {
        var v = get(o, "value", none)
        if get(o, "type", 0) == 6 and resolved != none and has(resolved, "users") and has(resolved["users"], string(v)) {
            v = make_user(b, resolved["users"][string(v)])
        }
        i.options[o["name"]] = v
    }
    for c in get(data, "components", []) {
        if has(c, "component") {
            read_field(i.fields, c["component"])
        }
        if has(c, "components") {
            for cc in c["components"] {
                read_field(i.fields, cc)
            }
        }
    }
    return i
}

func read_field fields @map, c {
    if not has(c, "custom_id") {
        return
    }
    if has(c, "value") {
        fields[c["custom_id"]] = c["value"]
    } elif has(c, "values") {
        fields[c["custom_id"]] = c["values"]
    }
}

# ═════════════════════════════════════════════
#  تحويل المكونات لـ JSON
# ═════════════════════════════════════════════

func Bot._new_id {
    if self.id_prefix == "" {
        self.id_prefix = "eo" + string(random(100000, 999999))
    }
    self.next_id += 1
    return self.id_prefix + "-" + string(self.next_id)
}

func Bot._track item {
    if item.id == "" {
        item.id = self._new_id()
    }
    self.ui[item.id] = item
    return item.id
}

func build_items b, items @list {
    var out = []
    for x in items {
        var t = type(x)
        if t == "View" {
            for r in view_rows(b, x) {
                append out, r
            }
        } elif t == "Container" {
            append out, {"type": 17, "accent_color": x.color, "spoiler": x.spoiler, "components": build_items(b, x.items)}
        } elif t == "Section" {
            append out, {"type": 9, "components": [text_display(x.text)], "accessory": accessory_json(b, x.accessory)}
        } elif t == "string" {
            append out, text_display(x)
        } else {
            append out, x
        }
    }
    return out
}

func accessory_json b, a {
    if type(a) == "Button" {
        return button_json(b, a)
    }
    return {"type": 11, "media": {"url": string(a)}}
}

func view_rows b, v @View {
    var rows = []
    var cur = []
    for item in v.items {
        var t = type(item)
        if t == "string" {
            if len(cur) > 0 {
                append rows, {"type": 1, "components": cur}
                cur = []
            }
        } elif t == "Select" {
            if len(cur) > 0 {
                append rows, {"type": 1, "components": cur}
                cur = []
            }
            append rows, {"type": 1, "components": [select_json(b, item)]}
        } else {
            if len(cur) == 5 {
                append rows, {"type": 1, "components": cur}
                cur = []
            }
            append cur, button_json(b, item)
        }
    }
    if len(cur) > 0 {
        append rows, {"type": 1, "components": cur}
    }
    return rows
}

func style_number s @string {
    var styles = {"blue": 1, "primary": 1, "gray": 2, "grey": 2, "secondary": 2, "green": 3, "success": 3, "red": 4, "danger": 4}
    return get(styles, lower(s), 1)
}

func emoji_json e @string {
    var parts = split(e, ":")
    if len(parts) == 2 {
        return {"name": parts[0], "id": parts[1]}
    }
    return {"name": e}
}

func button_json b, btn @Button {
    var j = {"type": 2, "label": btn.label, "disabled": btn.disabled}
    if btn.url != "" {
        j["style"] = 5
        j["url"] = btn.url
    } else {
        j["style"] = style_number(btn.style)
        j["custom_id"] = b._track(btn)
    }
    if btn.emoji != "" {
        j["emoji"] = emoji_json(btn.emoji)
    }
    return j
}

func select_json b, s @Select {
    var kinds = {"text": 3, "user": 5, "role": 6, "mention": 7, "channel": 8}
    var j = {"type": get(kinds, s.kind, 3), "custom_id": b._track(s), "placeholder": s.placeholder, "min_values": s.min, "max_values": s.max, "disabled": s.disabled}
    if j["type"] == 3 {
        j["options"] = map(s.options, lambda o { option_json(o) })
    }
    return j
}

func option_json o {
    if type(o) == "map" {
        return o
    }
    return {"label": string(o), "value": string(o)}
}

func modal_json b, form @Modal {
    var labels = []
    for t in form.inputs {
        var id = t.id
        if id == "" {
            id = t.label
        }
        var input = {"type": 4, "custom_id": id, "style": t.style, "required": t.required, "min_length": t.min, "max_length": t.max}
        if t.placeholder != "" {
            input["placeholder"] = t.placeholder
        }
        if t.value != "" {
            input["value"] = t.value
        }
        var label = {"type": 18, "label": t.label, "component": input}
        if t.description != "" {
            label["description"] = t.description
        }
        append labels, label
    }
    return {"custom_id": b._track(form), "title": form.title, "components": labels}
}

# ═════════════════════════════════════════════
#  User: الخاص
# ═════════════════════════════════════════════

# user.send "هلا"   (رسالة على الخاص)
func User.send content {
    return self.client.dm(self.id, content)
}

# bot.dm user, "نص"   (user = رقم أو User أو Member)
func Bot.dm user, content {
    var id = id_of(user)
    var cid = self._dm_channel(id)
    if cid == "" {
        return none
    }
    var r = self.request("POST", "/channels/" + cid + "/messages", message_body(self, content))
    if r != none and get(r, "code", 0) == 50007 {
        self._log "User " + id + " has DMs closed"
        return none
    }
    return r
}

# bot.fetch_user "رقم"
func Bot.fetch_user id {
    var d = self.request("GET", "/users/" + id_of(id))
    if d == none or not has(d, "id") {
        return none
    }
    return make_user(self, d)
}

# ═════════════════════════════════════════════
#  Member: عضو في سيرفر
# ═════════════════════════════════════════════

struct Member {
    id @string
    name @string
    display_name @string
    nick @string
    mention @string
    avatar_url @string
    bot @bool
    user @User
    roles @list
    joined_at @string
    timed_out_until @string
    permissions @string
    guild_id @string
    raw @map
    client @(Bot, none)
}

func make_member b, d, guild_id, user_d {
    if d == none {
        d = {}
    }
    var ud = get(d, "user", none)
    if ud == none {
        ud = user_d
    }
    var u = make_user(b, ud)
    var m = Member{id: u.id, name: u.name, display_name: u.display_name, nick: text_of(d, "nick"), mention: u.mention, avatar_url: u.avatar_url, bot: u.bot, user: u, joined_at: text_of(d, "joined_at"), timed_out_until: text_of(d, "communication_disabled_until"), permissions: text_of(d, "permissions"), guild_id: string(guild_id), raw: d, client: b}
    if m.nick != "" {
        m.display_name = m.nick
    }
    m.roles = map(get(d, "roles", []), lambda r { string(r) })
    return m
}

func Member._path {
    return "/guilds/" + self.guild_id + "/members/" + self.id
}

# member.send "هلا"   (خاص)
func Member.send content {
    return self.client.dm(self.id, content)
}

# member.kick   أو   member.kick "سبام"
func Member.kick reason @string = "" {
    return self.client.request("DELETE", self._path(), none, reason)
}

# member.ban   أو   member.ban "سبب", 1   (الرقم = كم يوم من رسايله ينحذف، لين 7)
func Member.ban reason @string = "", delete_days @int = 0 {
    return self.client.request("PUT", "/guilds/" + self.guild_id + "/bans/" + self.id, {"delete_message_seconds": delete_days * 86400}, reason)
}

# member.timeout 600   (يسكته 10 دقايق، لين 28 يوم)
func Member.timeout seconds, reason @string = "" {
    var until = time_iso(now() + seconds)
    self.timed_out_until = until
    return self.client.request("PATCH", self._path(), {"communication_disabled_until": until}, reason)
}

func Member.untimeout reason @string = "" {
    self.timed_out_until = ""
    return self.client.request("PATCH", self._path(), {"communication_disabled_until": none}, reason)
}

# member.add_role role   (role = Role أو رقمها)
func Member.add_role role, reason @string = "" {
    var id = id_of(role)
    if not (id in self.roles) {
        append self.roles, id
    }
    return self.client.request("PUT", self._path() + "/roles/" + id, none, reason)
}

func Member.remove_role role, reason @string = "" {
    var id = id_of(role)
    self.roles = filter(self.roles, lambda r { r != id })
    return self.client.request("DELETE", self._path() + "/roles/" + id, none, reason)
}

# member.has_role role   (Role أو رقمها أو اسمها)
func Member.has_role role {
    if type(role) == "string" and not (role in self.roles) {
        var g = get(self.client.guilds, self.guild_id, none)
        if g != none {
            var r = g.find_role(role)
            if r != none {
                return r.id in self.roles
            }
        }
        return false
    }
    return id_of(role) in self.roles
}

# member.set_nick "اسم"   ("" يرجعه لاسمه)
# ═════ الصلاحيات ═════

# msg.member.has_permission "ban_members"   أو   msg.member.has_permission discord.BAN_MEMBERS
#   صاحب السيرفر و Administrator عندهم كل شي
func Member.has_permission perm {
    var bit = permission_bit(perm)
    if bit <= 0 {
        if self.client != none {
            self.client._log "Unknown permission: " + string(perm) + " (examples: administrator, ban_members, kick_members, manage_messages)"
        }
        return false
    }
    if self.is_owner() {
        return true
    }
    # من الأزرار وأوامر السلاش: ديسكورد يرسل الصلاحيات محسوبة
    if is_digits(self.permissions) {
        var p = int(self.permissions)
        return has_bit(p, ADMINISTRATOR) or has_bit(p, bit)
    }
    var g = get(self.client.guilds, self.guild_id, none)
    if g == none {
        return false
    }
    for r in g.roles {
        # @everyone رقمها نفس رقم السيرفر
        if r.id == self.guild_id or r.id in self.roles {
            if has_bit(r.permissions, ADMINISTRATOR) or has_bit(r.permissions, bit) {
                return true
            }
        }
    }
    return false
}

# msg.member.is_admin
func Member.is_admin {
    return self.has_permission(ADMINISTRATOR)
}

# صاحب السيرفر؟
func Member.is_owner {
    if self.client == none {
        return false
    }
    var g = get(self.client.guilds, self.guild_id, none)
    return g != none and g.owner_id == self.id
}

func has_bit n @int, bit @int {
    return (n / bit) % 2 == 1
}

func permission_bit perm {
    if type(perm) == "int" {
        return perm
    }
    return get(PERMISSIONS, replace(lower(trim(string(perm))), " ", "_"), 0)
}

func Member.set_nick nick @string, reason @string = "" {
    self.nick = nick
    return self.client.request("PATCH", self._path(), {"nick": nick}, reason)
}

# الرتب كـ Role (من الكاش)
func Member.role_list {
    var g = get(self.client.guilds, self.guild_id, none)
    var out = []
    if g == none {
        return out
    }
    for r in g.roles {
        if r.id in self.roles {
            append out, r
        }
    }
    return out
}

# ═════════════════════════════════════════════
#  Guild: السيرفر
# ═════════════════════════════════════════════

struct Guild {
    id @string
    name @string
    owner_id @string
    member_count @int
    icon_url @string
    channels @list
    roles @list
    raw @map
    client @(Bot, none)
}

struct Channel {
    id @string
    name @string
    jump_url @string
    kind @int
    topic @string
    guild_id @string
    parent_id @string
    position @int
    mention @string
    raw @map
    client @(Bot, none)
}

struct Role {
    id @string
    name @string
    color @int
    position @int
    permissions @int
    mention @string
    guild_id @string
    raw @map
    client @(Bot, none)
}

# أنواع القنوات (channel.kind)
const TEXT = 0
const DM = 1
const VOICE = 2
const CATEGORY = 4
const NEWS = 5
const STAGE = 13
const FORUM = 15

func make_guild b, d {
    var id = text_of(d, "id")
    var icon = ""
    if text_of(d, "icon") != "" {
        icon = "https://cdn.discordapp.com/icons/" + id + "/" + text_of(d, "icon") + ".png"
    }
    var count = get(d, "member_count", none)
    if count == none {
        count = get(d, "approximate_member_count", 0)
    }
    var g = Guild{id: id, name: text_of(d, "name"), owner_id: text_of(d, "owner_id"), member_count: count, icon_url: icon, raw: d, client: b}
    for c in get(d, "channels", []) {
        append g.channels, make_channel(b, c, id)
    }
    for r in get(d, "roles", []) {
        append g.roles, make_role(b, r, id)
    }
    return g
}

func make_channel b, d, guild_id {
    var gid = text_of(d, "guild_id")
    if gid == "" {
        gid = string(guild_id)
    }
    var id = text_of(d, "id")
    return Channel{id: id, name: text_of(d, "name"), jump_url: jump_url(gid, id, ""), kind: get(d, "type", 0), topic: text_of(d, "topic"), guild_id: gid, parent_id: text_of(d, "parent_id"), position: get(d, "position", 0), mention: "<#" + id + ">", raw: d, client: b}
}

func make_role b, d, guild_id {
    var id = text_of(d, "id")
    var perms = 0
    if is_digits(text_of(d, "permissions")) {
        perms = int(text_of(d, "permissions"))
    }
    return Role{id: id, name: text_of(d, "name"), color: get(d, "color", 0), position: get(d, "position", 0), permissions: perms, mention: "<@&" + id + ">", guild_id: string(guild_id), raw: d, client: b}
}

# guild.member "رقم"  → Member (من ديسكورد)
func Guild.member user {
    var d = self.client.request("GET", "/guilds/" + self.id + "/members/" + id_of(user))
    if d == none or not has(d, "user") {
        return none
    }
    return make_member(self.client, d, self.id, none)
}

# guild.members   أو   guild.members 500   (يحتاج GUILD_MEMBERS)
func Guild.members limit @int = 1000 {
    var out = []
    var after = "0"
    while len(out) < limit {
        var n = limit - len(out)
        if n > 1000 {
            n = 1000
        }
        var page = self.client.request("GET", "/guilds/" + self.id + "/members?limit=" + string(n) + "&after=" + after)
        if type(page) != "list" or len(page) == 0 {
            break
        }
        for d in page {
            append out, make_member(self.client, d, self.id, none)
        }
        after = out[len(out) - 1].id
        if len(page) < n {
            break
        }
    }
    return out
}

func Guild.kick user, reason @string = "" {
    return self.client.request("DELETE", "/guilds/" + self.id + "/members/" + id_of(user), none, reason)
}

func Guild.ban user, reason @string = "", delete_days @int = 0 {
    return self.client.request("PUT", "/guilds/" + self.id + "/bans/" + id_of(user), {"delete_message_seconds": delete_days * 86400}, reason)
}

func Guild.unban user, reason @string = "" {
    return self.client.request("DELETE", "/guilds/" + self.id + "/bans/" + id_of(user), none, reason)
}

# قائمة المبندين: كل واحد {"user": User, "reason": "..."}
func Guild.bans {
    var out = []
    var page = self.client.request("GET", "/guilds/" + self.id + "/bans?limit=1000")
    if type(page) != "list" {
        return out
    }
    for d in page {
        append out, {"user": make_user(self.client, d["user"]), "reason": text_of(d, "reason")}
    }
    return out
}

# guild.find_channel "general"   (بالاسم أو الرقم)
func Guild.find_channel name {
    for c in self.channels {
        if c.id == id_of(name) or lower(c.name) == lower(string(name)) or lower(c.name) == lower(replace(string(name), "#", "")) {
            return c
        }
    }
    return none
}

# guild.find_role "Admin"   (بالاسم أو الرقم)
func Guild.find_role name {
    for r in self.roles {
        if r.id == id_of(name) or lower(r.name) == lower(string(name)) {
            return r
        }
    }
    return none
}

# guild.create_channel "اسم"   (أو guild.create_channel "صوت", discord.VOICE)
func Guild.create_channel name @string, kind @int = 0, category = none {
    var body = {"name": name, "type": kind}
    if category != none {
        body["parent_id"] = id_of(category)
    }
    var d = self.client.request("POST", "/guilds/" + self.id + "/channels", body)
    if d == none or not has(d, "id") {
        return none
    }
    var c = make_channel(self.client, d, self.id)
    append self.channels, c
    return c
}

# guild.create_role "VIP"   (أو guild.create_role "VIP", 16766720)
func Guild.create_role name @string, color @int = 0 {
    var d = self.client.request("POST", "/guilds/" + self.id + "/roles", {"name": name, "color": color})
    if d == none or not has(d, "id") {
        return none
    }
    var r = make_role(self.client, d, self.id)
    append self.roles, r
    return r
}

# البوت يطلع من السيرفر
func Guild.leave {
    return self.client.request("DELETE", "/users/@me/guilds/" + self.id)
}

# ═════════════════════════════════════════════
#  Channel و Role
# ═════════════════════════════════════════════

func Channel.send content {
    return self.client.send(self.id, content)
}

# آخر الرسائل (الأحدث أول)
func Channel.history limit @int = 50 {
    var out = []
    var page = self.client.request("GET", "/channels/" + self.id + "/messages?limit=" + string(limit))
    if type(page) != "list" {
        return out
    }
    for d in page {
        append out, make_message(self.client, d)
    }
    return out
}

# channel.purge 20   (يحذف آخر 20 رسالة، لين 100، وأحدث من 14 يوم)
func Channel.purge count @int = 10 {
    if count > 100 {
        count = 100
    }
    var ids = map(self.history(count), lambda m { m.id })
    if len(ids) == 0 {
        return 0
    }
    if len(ids) == 1 {
        self.client.request("DELETE", "/channels/" + self.id + "/messages/" + ids[0])
    } else {
        self.client.request("POST", "/channels/" + self.id + "/messages/bulk-delete", {"messages": ids})
    }
    return len(ids)
}

# "البوت يكتب..."
func Channel.typing {
    return self.client.request("POST", "/channels/" + self.id + "/typing")
}

func Channel.rename name @string {
    self.name = name
    return self.client.request("PATCH", "/channels/" + self.id, {"name": name})
}

func Channel.set_topic topic @string {
    self.topic = topic
    return self.client.request("PATCH", "/channels/" + self.id, {"topic": topic})
}

func Channel.delete reason @string = "" {
    return self.client.request("DELETE", "/channels/" + self.id, none, reason)
}

func Role.delete reason @string = "" {
    return self.client.request("DELETE", "/guilds/" + self.guild_id + "/roles/" + self.id, none, reason)
}

func Role.rename name @string {
    self.name = name
    return self.client.request("PATCH", "/guilds/" + self.guild_id + "/roles/" + self.id, {"name": name})
}

# ═════════════════════════════════════════════
#  الكاش: bot.guild و bot.channel
# ═════════════════════════════════════════════

# bot.guild "رقم"  → Guild (من الكاش، أو يجيبه من ديسكورد)
func Bot.guild id {
    var gid = id_of(id)
    if has(self.guilds, gid) {
        return self.guilds[gid]
    }
    var d = self.request("GET", "/guilds/" + gid + "?with_counts=true")
    if d == none or not has(d, "id") {
        return none
    }
    var g = make_guild(self, d)
    var chans = self.request("GET", "/guilds/" + gid + "/channels")
    if type(chans) == "list" {
        for c in chans {
            append g.channels, make_channel(self, c, gid)
        }
    }
    self.guilds[gid] = g
    return g
}

# bot.channel "رقم"  → Channel (من الكاش، وإلا Channel فيه الرقم بس)
func Bot.channel id {
    var cid = id_of(id)
    for gid in keys(self.guilds) {
        for c in self.guilds[gid].channels {
            if c.id == cid {
                return c
            }
        }
    }
    return Channel{id: cid, jump_url: jump_url("", cid, ""), mention: "<#" + cid + ">", client: self}
}

# كل السيرفرات اللي فيها البوت
func Bot.guild_list {
    return values(self.guilds)
}

# ═════════════════════════════════════════════
#  الحالة: Playing / Watching ...
# ═════════════════════════════════════════════

# bot.playing "eo"   bot.watching "السيرفر"   bot.listening "قرآن"   bot.competing "بطولة"
func Bot.playing text @string {
    self._set_activity(text, 0)
}
func Bot.listening text @string {
    self._set_activity(text, 2)
}
func Bot.watching text @string {
    self._set_activity(text, 3)
}
func Bot.competing text @string {
    self._set_activity(text, 5)
}

# bot.set_status "idle"   ("online" "idle" "dnd" "invisible")
func Bot.set_status status @string {
    self.status = status
    self._send_presence()
}

func Bot._set_activity text @string, kind @int {
    self.activity = text
    self.activity_kind = kind
    self._send_presence()
}

func Bot._presence {
    var acts = []
    if self.activity != "" {
        append acts, {"name": self.activity, "type": self.activity_kind}
    }
    return {"since": none, "activities": acts, "status": self.status, "afk": false}
}

func Bot._send_presence {
    if self.ws != none {
        ws_send self.ws, {"op": 3, "d": self._presence()}
    }
}

# ═════════════════════════════════════════════
#  Reaction والأحداث الإضافية
# ═════════════════════════════════════════════

struct Reaction {
    emoji @string
    user_id @string
    member @(Member, none)
    message_id @string
    channel_id @string
    guild_id @string
    raw @map
    client @(Bot, none)
}

# r.user()  → User (من ديسكورد)
func Reaction.user {
    return self.client.fetch_user(self.user_id)
}

# r.remove   (يشيل الرياكشن حق الشخص)
func Reaction.remove {
    return self.client.request("DELETE", "/channels/" + self.channel_id + "/messages/" + self.message_id + "/reactions/" + url_encode(self.emoji) + "/" + self.user_id)
}

func make_reaction b, d {
    var e = get(d, "emoji", {})
    var name = text_of(e, "name")
    if text_of(e, "id") != "" {
        name = name + ":" + text_of(e, "id")
    }
    var r = Reaction{emoji: name, user_id: text_of(d, "user_id"), message_id: text_of(d, "message_id"), channel_id: text_of(d, "channel_id"), guild_id: text_of(d, "guild_id"), raw: d, client: b}
    if has(d, "member") and d["member"] != none {
        r.member = make_member(b, d["member"], r.guild_id, none)
    }
    return r
}

func Bot._dispatch_more t @string, d {
    if t == "GUILD_CREATE" {
        var g = make_guild(self, d)
        self.guilds[g.id] = g
        if has(self.startup_guilds, g.id) {
            remove self.startup_guilds, g.id
        } else {
            self._emit("guild_join", [g])
        }
    } elif t == "GUILD_UPDATE" {
        var g = get(self.guilds, text_of(d, "id"), none)
        if g != none {
            g.name = text_of(d, "name")
            g.owner_id = text_of(d, "owner_id")
            g.raw = d
        }
    } elif t == "GUILD_DELETE" {
        var id = text_of(d, "id")
        if get(d, "unavailable", false) != true and has(self.guilds, id) {
            var g = self.guilds[id]
            remove self.guilds, id
            self._emit("guild_leave", [g])
        }
    } elif t == "GUILD_MEMBER_ADD" {
        var m = make_member(self, d, text_of(d, "guild_id"), none)
        var g = get(self.guilds, m.guild_id, none)
        if g != none {
            g.member_count += 1
        }
        self._emit("member_join", [m])
    } elif t == "GUILD_MEMBER_REMOVE" {
        var m = make_member(self, {"user": d["user"]}, text_of(d, "guild_id"), none)
        var g = get(self.guilds, m.guild_id, none)
        if g != none {
            g.member_count -= 1
        }
        self._emit("member_leave", [m])
    } elif t == "GUILD_MEMBER_UPDATE" {
        self._emit("member_update", [make_member(self, d, text_of(d, "guild_id"), none)])
    } elif t == "MESSAGE_UPDATE" {
        if has(d, "author") {
            self._emit("message_edit", [make_message(self, d)])
        }
    } elif t == "MESSAGE_DELETE" {
        self._emit("message_delete", [Message{id: text_of(d, "id"), channel_id: text_of(d, "channel_id"), guild_id: text_of(d, "guild_id"), author: make_user(self, {}), bot: self, raw: d}])
    } elif t == "MESSAGE_REACTION_ADD" {
        self._emit("reaction_add", [make_reaction(self, d)])
    } elif t == "MESSAGE_REACTION_REMOVE" {
        self._emit("reaction_remove", [make_reaction(self, d)])
    } elif t == "CHANNEL_CREATE" or t == "CHANNEL_UPDATE" or t == "CHANNEL_DELETE" {
        var c = make_channel(self, d, "")
        var g = get(self.guilds, c.guild_id, none)
        if g != none {
            g.channels = filter(g.channels, lambda x { x.id != c.id })
            if t != "CHANNEL_DELETE" {
                append g.channels, c
            }
        }
        if t == "CHANNEL_CREATE" {
            self._emit("channel_create", [c])
        } elif t == "CHANNEL_DELETE" {
            self._emit("channel_delete", [c])
        }
    } elif t == "GUILD_ROLE_CREATE" or t == "GUILD_ROLE_UPDATE" or t == "GUILD_ROLE_DELETE" {
        var gid = text_of(d, "guild_id")
        var g = get(self.guilds, gid, none)
        if g != none {
            var rid = text_of(d, "role_id")
            if has(d, "role") {
                rid = text_of(d["role"], "id")
            }
            g.roles = filter(g.roles, lambda x { x.id != rid })
            if t != "GUILD_ROLE_DELETE" {
                append g.roles, make_role(self, d["role"], gid)
            }
        }
    }
}

# "<#123>" → "123"
func strip_mention x @string {
    var out = ""
    for ch in x {
        if ch in "0123456789" {
            out = out + ch
        }
    }
    return out
}

func is_digits s @string {
    if s == "" or len(s) > 19 {
        return false
    }
    for ch in s {
        if not (ch in "0123456789") {
            return false
        }
    }
    return true
}

# رقم من أي شي: "123" أو User أو Member أو Channel أو Role أو Guild أو Message
func id_of x {
    var t = type(x)
    if t == "string" {
        # "<@123>" "<@!123>" "<#123>" "<@&123>" → "123"
        if startswith(x, "<") and endswith(x, ">") {
            return strip_mention(x)
        }
        return x
    }
    if t == "int" {
        return string(x)
    }
    if t == "User" or t == "Member" or t == "Channel" or t == "Role" or t == "Guild" or t == "Message" {
        return x.id
    }
    return string(x)
}

# ═════════════════════════════════════════════
#  اختصارات: send_embed و send_file لكل شي
# ═════════════════════════════════════════════

func make_embed title @string, text @string, color @int {
    var e = Embed(title, text)
    e.color = color
    return e
}

# discord.color("#57F287") → 5763719
func color hex @string {
    var h = lower(replace(trim(hex), "#", ""))
    var digits = "0123456789abcdef"
    var n = 0
    for ch in h {
        var d = 0
        while d < 16 and slice(digits, d, d + 1) != ch {
            d += 1
        }
        if d == 16 {
            return COLOR
        }
        n = n * 16 + d
    }
    return n
}

# bot.send_embed channel_id, "عنوان", "نص"   (واللون اختياري: , discord.GREEN)
func Bot.send_embed channel, title @string, text @string = "", color @int = COLOR {
    return self.send(id_of(channel), make_embed(title, text, color))
}
func Message.send_embed title @string, text @string = "", color @int = COLOR {
    return self.bot.send(self.channel_id, make_embed(title, text, color))
}
func Channel.send_embed title @string, text @string = "", color @int = COLOR {
    return self.client.send(self.id, make_embed(title, text, color))
}
# target.send_embed "عنوان", "نص"   (على الخاص)
func User.send_embed title @string, text @string = "", color @int = COLOR {
    return self.client.dm(self.id, make_embed(title, text, color))
}
func Member.send_embed title @string, text @string = "", color @int = COLOR {
    return self.client.dm(self.id, make_embed(title, text, color))
}
func Bot.dm_embed user, title @string, text @string = "", color @int = COLOR {
    return self.dm(user, make_embed(title, text, color))
}

# ── الملفات ──

# bot.send_file channel_id, "صورة.png"   (والنص أو الـ Embed اختياري)
#   e.image = "attachment://صورة.png"  يحط الصورة داخل الـ Embed
func Bot.send_file channel, path @string, content = "" {
    var cid = id_of(channel)
    if not file_exists(path) {
        self._log "File not found: " + path
        return none
    }
    var name = path
    var parts = split(replace(path, "\\", "/"), "/")
    name = parts[len(parts) - 1]
    var payload = {}
    if content != "" and content != none {
        payload = message_body(self, content)
    }
    payload["attachments"] = [{"id": 0, "filename": name}]
    var b = "eoBoundary" + string(random(100000000, 999999999))
    var body = "--" + b + "\r\nContent-Disposition: form-data; name=\"payload_json\"\r\nContent-Type: application/json\r\n\r\n" + json_encode(payload) + "\r\n"
    body = body + "--" + b + "\r\nContent-Disposition: form-data; name=\"files[0]\"; filename=\"" + name + "\"\r\nContent-Type: application/octet-stream\r\n\r\n" + read_file(path) + "\r\n--" + b + "--\r\n"
    return self.request("POST", "/channels/" + cid + "/messages", body, "", "multipart/form-data; boundary=" + b)
}
func Message.send_file path @string, content = "" {
    return self.bot.send_file(self.channel_id, path, content)
}
func Channel.send_file path @string, content = "" {
    return self.client.send_file(self.id, path, content)
}
func User.send_file path @string, content = "" {
    return self.client._dm_file(self.id, path, content)
}
func Member.send_file path @string, content = "" {
    return self.client._dm_file(self.id, path, content)
}

func Bot._dm_channel user {
    var id = id_of(user)
    if not has(self.dm_channels, id) {
        var ch = self.request("POST", "/users/@me/channels", {"recipient_id": id})
        if ch == none or not has(ch, "id") {
            self._log "Can't open a DM with " + id
            return ""
        }
        self.dm_channels[id] = string(ch["id"])
    }
    return self.dm_channels[id]
}

func Bot._dm_file user, path @string, content {
    var cid = self._dm_channel(user)
    if cid == "" {
        return none
    }
    return self.send_file(cid, path, content)
}

# رابط يفتح القناة أو الرسالة لما تضغطه
func jump_url guild_id @string, channel_id @string, message_id @string {
    var g = guild_id
    if g == "" {
        g = "@me"
    }
    var url = "https://discord.com/channels/" + g + "/" + channel_id
    if message_id != "" {
        url = url + "/" + message_id
    }
    return url
}
